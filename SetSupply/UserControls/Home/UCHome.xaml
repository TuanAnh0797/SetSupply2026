<UserControl x:Class="APP.UserControls.UCHome"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:home="clr-namespace:SetSupply.Models.Home"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:componentUI="clr-namespace:APP.ComponentUI"
             mc:Ignorable="d"
             FontFamily="Bahnschrift SemiCondensed, Segoe UI"
             d:DesignHeight="900" d:DesignWidth="1800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Độ rộng cột cố định (đồng bộ với hằng số trong UCHomeViewModel) -->
        <GridLength x:Key="GroupColW">170</GridLength>
        <GridLength x:Key="PlanColW">120</GridLength>
        <GridLength x:Key="ModelColW">250</GridLength>
        <GridLength x:Key="TotalColW">120</GridLength>
        <GridLength x:Key="SttColW">70</GridLength>

        <SolidColorBrush x:Key="NavyBrush" Color="#1D4F96"/>
        <SolidColorBrush x:Key="NavyDarkBrush" Color="#143F7E"/>
        <SolidColorBrush x:Key="HeaderLineBrush" Color="#3F6CB0"/>
        <SolidColorBrush x:Key="GridLineBrush" Color="#DCE4EF"/>
        <SolidColorBrush x:Key="TextDarkBrush" Color="#15305A"/>
        <SolidColorBrush x:Key="LabelBrush" Color="#1D4F96"/>

        <!-- ===== Ô của bảng ===== -->
        <Style x:Key="CellBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource GridLineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>
        <Style x:Key="HeaderCellBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource HeaderLineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style x:Key="HeaderText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <ItemsPanelTemplate x:Key="HourPanel">
            <UniformGrid Rows="1"/>
        </ItemsPanelTemplate>

        <DataTemplate x:Key="HourCellHeader">
            <Border Style="{StaticResource HeaderCellBorder}">
                <TextBlock Text="{Binding}" Style="{StaticResource HeaderText}" FontSize="15"/>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="HourCellGroup">
            <Border Style="{StaticResource CellBorder}">
                <TextBlock Text="{Binding}" Style="{StaticResource CellText}" FontWeight="SemiBold" FontSize="16"/>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="HourCellModel">
            <Border Style="{StaticResource CellBorder}">
                <TextBlock Text="{Binding}" Style="{StaticResource CellText}"/>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="HourCellFooter" DataType="{x:Type home:HourValueCell}">
            <Border Style="{StaticResource HeaderCellBorder}">
                <TextBlock Text="{Binding Text}" Style="{StaticResource HeaderText}" FontSize="17" Foreground="{Binding Foreground}"/>
            </Border>
        </DataTemplate>

        <!-- Dòng kế hoạch theo giờ (phía trên dòng Tổng) -->
        <SolidColorBrush x:Key="PlanRowBrush" Color="#E3EDFA"/>
        <Style x:Key="PlanCellBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="#C5D6EC"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>
        <Style x:Key="PlanText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="Foreground" Value="#1D4F96"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <DataTemplate x:Key="HourCellPlan">
            <Border Style="{StaticResource PlanCellBorder}">
                <TextBlock Text="{Binding}" Style="{StaticResource PlanText}"/>
            </Border>
        </DataTemplate>

        <!-- Nút +/- mở rộng nhóm -->
        <Style x:Key="ExpandButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#2B6BD6" CornerRadius="4">
                            <materialDesign:PackIcon x:Name="Icon" Kind="Minus" Width="18" Height="18"
                                                     Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                <Setter TargetName="Icon" Property="Kind" Value="Plus"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A56B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasChildren}" Value="False">
                    <Setter Property="Visibility" Value="Hidden"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox ở thanh lọc -->
        <Style x:Key="FilterCombo" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C3D1E5"/>
            <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="4"/>
            <Setter Property="materialDesign:ComboBoxAssist.ShowSelectedItem" Value="True"/>
        </Style>
        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- Ô Model: thumbnail + tên model (dùng cho dòng model con và dòng nhóm chỉ có 1 model) -->
        <DataTemplate x:Key="ModelCellContent" DataType="{x:Type home:ModelRow}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0">
                <Grid Width="22" Height="28" Margin="0,0,14,0">
                    <Image Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}"/>
                    <materialDesign:PackIcon Kind="FridgeOutline" Width="22" Height="26" Foreground="#7A8BA6">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasImage}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                </Grid>
                <TextBlock Text="{Binding ModelName}" Style="{StaticResource CellText}" FontSize="15"/>
            </StackPanel>
        </DataTemplate>

        <!-- ===== Dòng model (chi tiết) ===== -->
        <DataTemplate x:Key="ModelRowTemplate" DataType="{x:Type home:ModelRow}">
            <Border BorderBrush="{StaticResource GridLineBrush}" BorderThickness="0,0,0,1" Background="White">
                <Grid Height="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource GroupColW}"/>
                        <ColumnDefinition Width="{StaticResource PlanColW}"/>
                        <ColumnDefinition Width="{StaticResource ModelColW}"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="{StaticResource TotalColW}"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource CellBorder}" Background="{Binding TintBrush}"/>
                    <Border Grid.Column="1" Style="{StaticResource CellBorder}" Background="{Binding TintBrush}"/>
                    <Border Grid.Column="2" Style="{StaticResource CellBorder}">
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ModelCellContent}"/>
                    </Border>
                    <ItemsControl Grid.Column="3" ItemsSource="{Binding Hours}"
                                  ItemsPanel="{StaticResource HourPanel}" ItemTemplate="{StaticResource HourCellModel}"/>
                    <TextBlock Grid.Column="4" Text="{Binding TotalText}" Style="{StaticResource CellText}"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ===== Dòng nhóm + các dòng model con =====
             Nhóm 1 model: model hiện ngay trên dòng nhóm (không có dòng con).
             Nhóm nhiều model: ô Model hiện "N model", bấm +/- để xem / ẩn từng model. -->
        <DataTemplate x:Key="GroupRowTemplate" DataType="{x:Type home:ModelGroupRow}">
            <StackPanel>
                <Border BorderBrush="{StaticResource GridLineBrush}" BorderThickness="0,0,0,1" Background="{Binding RowBrush}">
                    <Grid Height="36">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource GroupColW}"/>
                            <ColumnDefinition Width="{StaticResource PlanColW}"/>
                            <ColumnDefinition Width="{StaticResource ModelColW}"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="{StaticResource TotalColW}"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CellBorder}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                <Button Style="{StaticResource ExpandButton}" Command="{Binding ToggleCommand}"/>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource CellText}"
                                           FontWeight="Bold" FontSize="17" Margin="12,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CellBorder}">
                            <TextBlock Text="{Binding PlanText}" Style="{StaticResource CellText}" FontWeight="Bold" FontSize="17"/>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CellBorder}">
                            <Grid>
                                <!-- ContentControl (không phải ContentPresenter) để binding Visibility vẫn theo dòng nhóm -->
                                <ContentControl Content="{Binding SingleModel}" ContentTemplate="{StaticResource ModelCellContent}"
                                                Focusable="False" IsTabStop="False"
                                                Visibility="{Binding HasSingleModel, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding ModelCountText}" Style="{StaticResource CellText}"
                                           HorizontalAlignment="Left" Margin="22,0,0,0" FontSize="14" FontStyle="Italic" Foreground="#6B7A90"/>
                            </Grid>
                        </Border>
                        <ItemsControl Grid.Column="3" ItemsSource="{Binding Hours}"
                                      ItemsPanel="{StaticResource HourPanel}" ItemTemplate="{StaticResource HourCellGroup}"/>
                        <TextBlock Grid.Column="4" Text="{Binding TotalText}" Style="{StaticResource CellText}"
                                   FontWeight="Bold" FontSize="17"/>
                    </Grid>
                </Border>
                <ItemsControl ItemsSource="{Binding Children}" ItemTemplate="{StaticResource ModelRowTemplate}"
                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </DataTemplate>

        <!-- ===== Chế độ danh sách model: STT | Model | giờ | Tổng ===== -->
        <DataTemplate x:Key="FlatRowTemplate" DataType="{x:Type home:ModelRow}">
            <Border BorderBrush="{StaticResource GridLineBrush}" BorderThickness="0,0,0,1" Background="{Binding RowBackground}">
                <Grid Height="34">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource SttColW}"/>
                        <ColumnDefinition Width="{StaticResource ModelColW}"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="{StaticResource TotalColW}"/>
                    </Grid.ColumnDefinitions>
                    <!-- Vạch màu bên trái = màu nhóm của model -->
                    <Border Grid.Column="0" Style="{StaticResource CellBorder}">
                        <Grid>
                            <Border Width="5" HorizontalAlignment="Left" Background="{Binding TintBrush}"/>
                            <TextBlock Text="{Binding Stt}" Style="{StaticResource CellText}" Foreground="#5B6B82"/>
                        </Grid>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource CellBorder}">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ModelCellContent}"
                                        Focusable="False" IsTabStop="False"/>
                    </Border>
                    <ItemsControl Grid.Column="2" ItemsSource="{Binding Hours}"
                                  ItemsPanel="{StaticResource HourPanel}" ItemTemplate="{StaticResource HourCellModel}"/>
                    <Border Grid.Column="3" Background="#EAF3FC">
                        <TextBlock Text="{Binding TotalText}" Style="{StaticResource CellText}" FontWeight="Bold" FontSize="16"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Nút chọn chế độ bảng (Theo nhóm / Theo model) -->
        <Style x:Key="ModeRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3" Padding="10,0" Height="32">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E3ECF8"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4F96"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Panel phía dưới ===== -->
        <GridLength x:Key="BarLabelW">90</GridLength>
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C9D6E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#8FA3C0" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.25"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelHeader" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource NavyBrush}"/>
            <Setter Property="CornerRadius" Value="5,5,0,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="KpiTile" TargetType="Border">
            <Setter Property="Background" Value="#F4F7FC"/>
            <Setter Property="BorderBrush" Value="#E1E8F2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>
        <Style x:Key="ShiftCell" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource GridLineBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- 1 dòng của bảng "Sản lượng theo ca" (dùng cho các ca và dòng Tổng) -->
        <DataTemplate x:Key="ShiftRowTemplate" DataType="{x:Type home:ShiftSummaryRow}">
            <Grid MinHeight="37">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource ShiftCell}" BorderThickness="1,0,1,1">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource CellText}" FontSize="14"/>
                        <TextBlock Text="{Binding TimeRange}" Style="{StaticResource CellText}" FontSize="11" Foreground="#5B6B82"
                                   Visibility="{Binding HasTimeRange, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource ShiftCell}">
                    <TextBlock Text="{Binding PlanText}" Style="{StaticResource CellText}"/>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource ShiftCell}">
                    <TextBlock Text="{Binding ActualText}" Style="{StaticResource CellText}"/>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource ShiftCell}" Background="{Binding RatioBackground}">
                    <TextBlock Text="{Binding RatioText}" Style="{StaticResource CellText}"
                               Foreground="{Binding RatioForeground}" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- 1 cột ngang của biểu đồ "Sản lượng theo nhóm model" -->
        <DataTemplate x:Key="GroupBarTemplate" DataType="{x:Type home:GroupBarItem}">
            <Grid Height="27">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource BarLabelW}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" FontSize="14" Foreground="{StaticResource TextDarkBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis"/>
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding BarLength}"/>
                        <ColumnDefinition Width="{Binding RestLength}"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{Binding BarBrush}" Height="19" CornerRadius="0,3,3,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding ValueText}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextDarkBrush}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="18,10,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="250"/>
        </Grid.RowDefinitions>

        <!-- ===== THANH LỌC ===== -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <!-- Chế độ bảng sản lượng (biểu đồ phía dưới không đổi) -->
                <Border Height="38" CornerRadius="4" Background="White" BorderBrush="#C3D1E5" BorderThickness="1"
                        Padding="2" Margin="0,0,22,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource ModeRadio}" IsChecked="{Binding IsGroupMode}"
                                     ToolTip="Bảng theo nhóm model (mở rộng / thu gọn từng nhóm)">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileTreeOutline" Width="18" Height="18" VerticalAlignment="Center"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="Theo nhóm" FontSize="15" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ModeRadio}" IsChecked="{Binding IsModelListMode}"
                                     ToolTip="Danh sách từng model có STT (không chia nhóm)">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FormatListNumbered" Width="18" Height="18" VerticalAlignment="Center"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="Theo model" FontSize="15" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <TextBlock Text="Nhóm model" Style="{StaticResource FilterLabel}"/>
                <ComboBox Width="200" Style="{StaticResource FilterCombo}" Margin="0,0,26,0"
                          ItemsSource="{Binding GroupFilterOptions}" SelectedItem="{Binding SelectedGroupFilter}"/>

                <TextBlock Text="Model" Style="{StaticResource FilterLabel}"/>
                <ComboBox Width="250" Style="{StaticResource FilterCombo}" Margin="0,0,26,0"
                          ItemsSource="{Binding ModelFilterOptions}" SelectedItem="{Binding SelectedModelFilter}"/>

                <!-- Codeback vừa đọc từ PLC -->
                <Border Height="38" CornerRadius="4" Background="White" BorderThickness="1" Padding="10,0"
                        BorderBrush="{Binding LastCodeStatusBrush}" VerticalAlignment="Center"
                        ToolTip="Mã (Codeback) vừa đọc từ PLC">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="Barcode" Width="24" Height="24" Foreground="{StaticResource LabelBrush}"
                                                 VerticalAlignment="Center"/>
                        <TextBlock Text="Codeback" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource LabelBrush}"
                                   VerticalAlignment="Center" Margin="8,0,12,0"/>
                        <TextBlock Text="{Binding LastCodeText}" FontFamily="Consolas" FontSize="19" FontWeight="Bold"
                                   Foreground="{StaticResource TextDarkBrush}" VerticalAlignment="Center" MinWidth="215"/>
                        <TextBlock Text="{Binding LastCodeTimeText}" FontSize="14" Foreground="#5B6B82"
                                   VerticalAlignment="Center" Margin="10,0,10,0"/>
                        <Border CornerRadius="3" Background="{Binding LastCodeStatusBrush}" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LastCodeStatusText}" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Mặc định chỉ hiện nhóm có sản lượng thực tế -->
                <CheckBox IsChecked="{Binding ShowEmptyGroups}" Content="Hiển thị theo kế hoạch" FontSize="14"
                          Visibility="{Binding IsGroupMode, Converter={StaticResource BoolToVis}}"
                          Foreground="{StaticResource TextDarkBrush}" VerticalAlignment="Center" Margin="20,0,0,0"
                          ToolTip="Tích: hiện thêm nhóm có kế hoạch (ngày / ca đang xem) nhưng chưa có sản lượng. Ngày chưa import kế hoạch: chỉ hiện nhóm có sản lượng thực tế. Kế hoạch tổng chỉ cộng các nhóm đang hiện."/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Ngày đang xem có dữ liệu test (Cài đặt > Test Data) -->
                <Border CornerRadius="4" Background="#FFF4E5" BorderBrush="#F5A623" BorderThickness="1" Padding="8,3" Margin="0,0,16,0"
                        VerticalAlignment="Center" ToolTip="Dữ liệu test tạo ở Cài đặt > Test Data, xóa được ở đó"
                        Visibility="{Binding HasTestData, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FlaskOutline" Width="18" Height="18" Foreground="#E08A00" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding TestDataText}" FontSize="14" FontWeight="SemiBold" Foreground="#8A5300" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding LastUpdateText}" FontSize="14" Foreground="#5B6B82" VerticalAlignment="Center"/>
                <Ellipse Width="12" Height="12" Margin="20,0,8,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#E53935"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlcConnected}" Value="True">
                                    <Setter Property="Fill" Value="#22B14C"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding ConnectionText}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#E53935"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlcConnected}" Value="True">
                                    <Setter Property="Foreground" Value="#1E9E45"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <!-- ===== BẢNG SẢN LƯỢNG ===== -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" BorderBrush="#C9D6E8" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#8FA3C0" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.25"/>
            </Border.Effect>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid MinWidth="{Binding TableMinWidth}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" CornerRadius="5,5,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#245AA6" Offset="0"/>
                                <GradientStop Color="#1B4A8E" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                        <Grid x:Name="HeaderGrid" Height="54" Visibility="{Binding IsGroupMode, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource GroupColW}"/>
                                <ColumnDefinition Width="{StaticResource PlanColW}"/>
                                <ColumnDefinition Width="{StaticResource ModelColW}"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="{StaticResource TotalColW}"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource HeaderCellBorder}">
                                <Grid>
                                    <TextBlock Text="Nhóm model" Style="{StaticResource HeaderText}" Margin="26,0,0,0"/>
                                    <!-- Mở rộng / thu gọn tất cả nhóm -->
                                    <Button HorizontalAlignment="Left" Margin="10,0,0,0" Width="26" Height="26"
                                            Cursor="Hand" Focusable="False" Command="{Binding ToggleAllGroupsCommand}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="#33FFFFFF" CornerRadius="4">
                                                    <materialDesign:PackIcon x:Name="Icon" Kind="UnfoldLessHorizontal" Width="20" Height="20"
                                                                             Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding AllGroupsExpanded}" Value="False">
                                                        <Setter TargetName="Icon" Property="Kind" Value="UnfoldMoreHorizontal"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#66FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="ToolTip" Value="Thu gọn tất cả nhóm"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AllGroupsExpanded}" Value="False">
                                                        <Setter Property="ToolTip" Value="Mở rộng tất cả nhóm"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource HeaderCellBorder}">
                                <TextBlock Style="{StaticResource HeaderText}" FontSize="15" LineHeight="18">
                                    <Run Text="Sản lượng"/><LineBreak/><Run Text="(Kế hoạch)"/>
                                </TextBlock>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource HeaderCellBorder}">
                                <TextBlock Text="Model" Style="{StaticResource HeaderText}"/>
                            </Border>
                            <ItemsControl Grid.Column="3" ItemsSource="{Binding HourHeaders}"
                                          ItemsPanel="{StaticResource HourPanel}" ItemTemplate="{StaticResource HourCellHeader}"/>
                            <TextBlock Grid.Column="4" Text="Tổng" Style="{StaticResource HeaderText}" FontSize="17"/>
                        </Grid>
                        <Grid x:Name="FlatHeaderGrid" Height="54" Visibility="{Binding IsModelListMode, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{StaticResource SttColW}"/>
                                <ColumnDefinition Width="{StaticResource ModelColW}"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="{StaticResource TotalColW}"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource HeaderCellBorder}">
                                <TextBlock Text="STT" Style="{StaticResource HeaderText}"/>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource HeaderCellBorder}">
                                <TextBlock Text="Model" Style="{StaticResource HeaderText}"/>
                            </Border>
                            <ItemsControl Grid.Column="2" ItemsSource="{Binding HourHeaders}"
                                          ItemsPanel="{StaticResource HourPanel}" ItemTemplate="{StaticResource HourCellHeader}"/>
                            <TextBlock Grid.Column="3" Text="Tổng" Style="{StaticResource HeaderText}" FontSize="17"/>
                        </Grid>
                        </Grid>
                    </Border>

                    <!-- Nội dung -->
                    <ScrollViewer x:Name="BodyScroll" Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding Groups}" ItemTemplate="{StaticResource GroupRowTemplate}"
                                          Visibility="{Binding IsGroupMode, Converter={StaticResource BoolToVis}}"/>
                            <ItemsControl ItemsSource="{Binding FlatRows}" ItemTemplate="{StaticResource FlatRowTemplate}"
                                          Visibility="{Binding IsModelListMode, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </ScrollViewer>

                    <TextBlock Grid.Row="1" Text="Chưa có dữ liệu" FontSize="18" Foreground="#8A99B0"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTableEmpty}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Dòng kế hoạch (khi có import plan) + dòng tổng -->
                    <Border Grid.Row="2" Background="{StaticResource NavyDarkBrush}" CornerRadius="0,0,5,5">
                        <Grid DataContext="{Binding Totals}">
                            <!-- Chế độ theo nhóm -->
                            <StackPanel Visibility="{Binding DataContext.IsGroupMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                <Border Background="{StaticResource PlanRowBrush}" BorderBrush="#B9CDE8" BorderThickness="0,1,0,0"
                                        Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}">
                                    <Grid x:Name="PlanRowGrid" Height="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource GroupColW}"/>
                                            <ColumnDefinition Width="{StaticResource PlanColW}"/>
                                            <ColumnDefinition Width="{StaticResource ModelColW}"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="{StaticResource TotalColW}"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource PlanCellBorder}">
                                            <TextBlock Text="Kế hoạch theo giờ" Style="{StaticResource PlanText}" FontSize="16"/>
                                        </Border>
                                        <ItemsControl Grid.Column="3" ItemsSource="{Binding PlanHours}"
                                                      ItemsPanel="{StaticResource HourPanel}" ItemTemplate="{StaticResource HourCellPlan}"/>
                                        <TextBlock Grid.Column="4" Text="{Binding PlanTotalText}" Style="{StaticResource PlanText}" FontSize="17"/>
                                    </Grid>
                                </Border>
                                <Grid x:Name="FooterGrid" Height="46">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource GroupColW}"/>
                                        <ColumnDefinition Width="{StaticResource PlanColW}"/>
                                        <ColumnDefinition Width="{StaticResource ModelColW}"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="{StaticResource TotalColW}"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource HeaderCellBorder}">
                                        <TextBlock Text="Tổng" Style="{StaticResource HeaderText}" FontSize="19" FontWeight="Bold"/>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource HeaderCellBorder}">
                                        <TextBlock Text="{Binding PlanText}" Style="{StaticResource HeaderText}" FontSize="18" FontWeight="Bold"/>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource HeaderCellBorder}"/>
                                    <ItemsControl Grid.Column="3" ItemsSource="{Binding HourCells}"
                                                  ItemsPanel="{StaticResource HourPanel}" ItemTemplate="{StaticResource HourCellFooter}"/>
                                    <TextBlock Grid.Column="4" Text="{Binding TotalText}" Style="{StaticResource HeaderText}"
                                               FontSize="18" FontWeight="Bold"/>
                                </Grid>
                            </StackPanel>

                            <!-- Chế độ theo model -->
                            <StackPanel Visibility="{Binding DataContext.IsModelListMode, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                <Border Background="{StaticResource PlanRowBrush}" BorderBrush="#B9CDE8" BorderThickness="0,1,0,0"
                                        Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}">
                                    <Grid x:Name="FlatPlanRowGrid" Height="34">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource SttColW}"/>
                                            <ColumnDefinition Width="{StaticResource ModelColW}"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="{StaticResource TotalColW}"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource PlanCellBorder}">
                                            <TextBlock Text="Kế hoạch theo giờ" Style="{StaticResource PlanText}" FontSize="16"/>
                                        </Border>
                                        <ItemsControl Grid.Column="2" ItemsSource="{Binding PlanHours}"
                                                      ItemsPanel="{StaticResource HourPanel}" ItemTemplate="{StaticResource HourCellPlan}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding PlanTotalText}" Style="{StaticResource PlanText}" FontSize="17"/>
                                    </Grid>
                                </Border>
                                <Grid x:Name="FlatFooterGrid" Height="46">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource SttColW}"/>
                                        <ColumnDefinition Width="{StaticResource ModelColW}"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="{StaticResource TotalColW}"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource HeaderCellBorder}">
                                        <TextBlock Text="Tổng" Style="{StaticResource HeaderText}" FontSize="19" FontWeight="Bold"/>
                                    </Border>
                                    <ItemsControl Grid.Column="2" ItemsSource="{Binding HourCells}"
                                                  ItemsPanel="{StaticResource HourPanel}" ItemTemplate="{StaticResource HourCellFooter}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding TotalText}" Style="{StaticResource HeaderText}"
                                               FontSize="18" FontWeight="Bold"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- ===== PANEL PHÍA DƯỚI ===== -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.85*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="0.95*"/>
            </Grid.ColumnDefinitions>

            <!-- 1. Tổng quan ngày -->
            <Border Grid.Column="0" Style="{StaticResource PanelCard}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                        <TextBlock Text="{Binding OverviewTitle}" Style="{StaticResource PanelTitle}"/>
                    </Border>
                    <!-- Số liệu | vòng tròn tiến độ so với target hiện tại | biểu đồ cộng dồn thực tế - target -->
                    <Grid Margin="8,8,8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="0.78*"/>
                            <ColumnDefinition Width="1.45*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.Resources>
                            <Style x:Key="KpiLabel" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="Foreground" Value="#5B6B82"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                            <Style x:Key="KpiValue" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="25"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{StaticResource TextDarkBrush}"/>
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </Grid.Resources>

                        <!-- Số liệu -->
                        <Border Grid.Column="0" Style="{StaticResource KpiTile}" Margin="0,0,5,0" Padding="10,4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Kế hoạch" Style="{StaticResource KpiLabel}"/>
                                        <TextBlock Text="{Binding PlanSourceText}" FontSize="11" Foreground="#1F7BEA"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding PlanTotalText}" Style="{StaticResource KpiValue}"/>
                                </Grid>
                                <Border Grid.Row="1" BorderBrush="#E1E8F2" BorderThickness="0,1,0,1">
                                    <Grid>
                                        <TextBlock Text="{Binding TargetNowLabel}" Style="{StaticResource KpiLabel}"/>
                                        <TextBlock Text="{Binding TargetNowText}" Style="{StaticResource KpiValue}" Foreground="#5B6B82"/>
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="2">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Thực tế" Style="{StaticResource KpiLabel}"/>
                                        <TextBlock Text="{Binding AchievementText}" FontSize="11" Foreground="{Binding AchievementBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ActualTotalText}" Style="{StaticResource KpiValue}" Foreground="#1E9E45"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Tiến độ so với target đến hiện tại -->
                        <Border Grid.Column="1" Style="{StaticResource KpiTile}" Margin="0,0,5,0">
                            <Grid Margin="6">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <componentUI:RingProgress Value="{Binding ProgressPercent}" FillBrush="{Binding ProgressBrush}"
                                                          TrackBrush="#E3E9F2" StrokeThickness="12"/>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProgressText}" FontSize="22" FontWeight="Bold"
                                               Foreground="{StaticResource TextDarkBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="so với target" FontSize="12" Foreground="#5B6B82" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="{Binding DiffText}" FontSize="14" FontWeight="Bold" Foreground="{Binding DiffBrush}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </Border>

                        <!-- Thực tế cộng dồn so với target theo thời gian -->
                        <Border Grid.Column="2" Style="{StaticResource KpiTile}" Margin="0" Background="White">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4,0,0">
                                    <Rectangle Width="16" Height="3" Fill="#22B14C" VerticalAlignment="Center"/>
                                    <TextBlock Text="Thực tế cộng dồn" FontSize="12" Foreground="#5B6B82" Margin="4,0,10,0"/>
                                    <Rectangle Width="16" Height="2" Stroke="#8A99B0" StrokeDashArray="3 2" VerticalAlignment="Center"/>
                                    <TextBlock Text="Target" FontSize="12" Foreground="#5B6B82" Margin="4,0,0,0"/>
                                </StackPanel>
                                <lvc:CartesianChart Series="{Binding CumulativeSeries}" XAxes="{Binding CumulativeXAxes}" YAxes="{Binding CumulativeYAxes}"
                                                    TooltipPosition="Top" AnimationsSpeed="00:00:00.2" Margin="0,0,6,2"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- 2. Sản lượng theo nhóm model -->
            <Border Grid.Column="2" Style="{StaticResource PanelCard}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                        <TextBlock Text="{Binding GroupChartTitle}" Style="{StaticResource PanelTitle}"/>
                    </Border>
                    <Grid Margin="8,10,22,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource BarLabelW}"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="22"/>
                        </Grid.RowDefinitions>

                        <!-- Lưới dọc -->
                        <UniformGrid Grid.Column="1" Rows="1" Columns="4">
                            <Border BorderBrush="#DCE4EF" BorderThickness="1,0,0,0"/>
                            <Border BorderBrush="#DCE4EF" BorderThickness="1,0,0,0"/>
                            <Border BorderBrush="#DCE4EF" BorderThickness="1,0,0,0"/>
                            <Border BorderBrush="#DCE4EF" BorderThickness="1,0,1,0"/>
                        </UniformGrid>

                        <!-- Nhãn trục: 0, 1/4, 2/4, 3/4, max -->
                        <Grid Grid.Row="1" Grid.Column="1">
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Foreground" Value="#5B6B82"/>
                                    <Setter Property="Margin" Value="0,4,0,0"/>
                                </Style>
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Canvas Grid.Column="0"><TextBlock Text="{Binding GroupAxisLabels[0]}" Canvas.Left="-3"/></Canvas>
                            <Canvas Grid.Column="1"><TextBlock Text="{Binding GroupAxisLabels[1]}" Canvas.Left="-12"/></Canvas>
                            <Canvas Grid.Column="2"><TextBlock Text="{Binding GroupAxisLabels[2]}" Canvas.Left="-12"/></Canvas>
                            <Canvas Grid.Column="3"><TextBlock Text="{Binding GroupAxisLabels[3]}" Canvas.Left="-12"/></Canvas>
                            <Canvas Grid.Column="3" HorizontalAlignment="Right"><TextBlock Text="{Binding GroupAxisLabels[4]}" Canvas.Left="-14"/></Canvas>
                        </Grid>

                        <!-- Các cột ngang -->
                        <ItemsControl Grid.ColumnSpan="2" ItemsSource="{Binding GroupBars}" VerticalAlignment="Center"
                                      ItemTemplate="{StaticResource GroupBarTemplate}"/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- 3. Sản lượng theo khoảng thời gian (5/10/15/30 phút, 1 giờ, tùy chỉnh) -->
            <Border Grid.Column="4" Style="{StaticResource PanelCard}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}" Padding="14,0,6,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox ItemsSource="{Binding ChartIntervalOptions}" SelectedItem="{Binding SelectedChartInterval}" IsSynchronizedWithCurrentItem="False"
                                          DisplayMemberPath="Label" Width="96" Height="28" FontSize="13" Padding="8,2"
                                          Background="White" Foreground="{StaticResource TextDarkBrush}"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}" BorderBrush="White"
                                          ToolTip="Khoảng thời gian của biểu đồ"/>
                                <TextBox Text="{Binding CustomIntervalText, UpdateSourceTrigger=PropertyChanged, Delay=600}"
                                         Visibility="{Binding IsCustomInterval, Converter={StaticResource BoolToVis}}"
                                         Width="48" Height="28" Margin="6,0,0,0" Padding="4,2" FontSize="13"
                                         Background="White" Foreground="{StaticResource TextDarkBrush}"
                                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" BorderBrush="White"
                                         ToolTip="Số phút mỗi khoảng (1 - 720)"/>
                                <TextBlock Text="phút" Foreground="White" FontSize="13" VerticalAlignment="Center" Margin="4,0,0,0"
                                           Visibility="{Binding IsCustomInterval, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding HourlyChartTitle}" Style="{StaticResource PanelTitle}"/>
                        </DockPanel>
                    </Border>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="14,6,0,0">
                        <TextBlock Text="Sản lượng (tủ)" FontSize="12" Foreground="#5B6B82"/>
                        <Rectangle Width="16" Height="3" Fill="#1F7BEA" VerticalAlignment="Center" Margin="14,0,4,0"/>
                        <TextBlock Text="Thực tế" FontSize="12" Foreground="#5B6B82"/>
                        <Rectangle Width="16" Height="2" Stroke="#F58A1F" StrokeDashArray="3 2" VerticalAlignment="Center" Margin="10,0,4,0"/>
                        <TextBlock Text="Kế hoạch" FontSize="12" Foreground="#5B6B82"/>
                    </StackPanel>
                    <lvc:CartesianChart Series="{Binding HourlySeries}" XAxes="{Binding HourlyXAxes}" YAxes="{Binding HourlyYAxes}"
                                        TooltipPosition="Top" AnimationsSpeed="00:00:00.2" Margin="4,0,10,4"/>
                </DockPanel>
            </Border>

            <!-- 4. Sản lượng theo ca -->
            <Border Grid.Column="6" Style="{StaticResource PanelCard}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                        <TextBlock Text="Sản lượng theo ca" Style="{StaticResource PanelTitle}"/>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="10,8">
                        <StackPanel>
                            <Border Background="#EAF1FB" BorderBrush="{StaticResource GridLineBrush}" BorderThickness="1">
                                <Grid Height="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Ca" Style="{StaticResource CellText}" FontSize="14"/>
                                    <TextBlock Grid.Column="1" Text="Kế hoạch" Style="{StaticResource CellText}" FontSize="14"/>
                                    <TextBlock Grid.Column="2" Text="Thực tế" Style="{StaticResource CellText}" FontSize="14"/>
                                    <TextBlock Grid.Column="3" Text="Tỷ lệ (%)" Style="{StaticResource CellText}" FontSize="14"/>
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding ShiftSummaries}" ItemTemplate="{StaticResource ShiftRowTemplate}"/>
                            <ContentControl Content="{Binding ShiftSummaryTotal}" ContentTemplate="{StaticResource ShiftRowTemplate}"
                                            TextElement.FontWeight="Bold"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
