<UserControl x:Class="APP.UserControls.UCHomeHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             FontFamily="Bahnschrift SemiCondensed, Segoe UI"
             d:DesignHeight="60" d:DesignWidth="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Nút chọn ngày -->
        <Style x:Key="DateToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="#16478C" BorderBrush="#5B86C8" BorderThickness="1"
                                CornerRadius="5" Padding="14,0" Height="46">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D56A6"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D56A6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nút Cả ngày / Ca 1 / Ca 2 -->
        <Style x:Key="ScopeItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Foreground" Value="#143F7E"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="#E6EEF9" CornerRadius="5" MinWidth="118" Height="46" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D3E1F5"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F7BEA"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="#5B86C8" BorderThickness="1"
                                CornerRadius="5" Padding="14,0" Height="46">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D56A6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

        <!-- ===== Chọn ngày ===== -->
        <Grid Margin="0,0,16,0">
            <ToggleButton x:Name="DateButton" Style="{StaticResource DateToggle}"
                          IsChecked="{Binding IsDatePickerOpen, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="CalendarMonthOutline" Width="24" Height="24" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedDateText}" FontSize="19" FontWeight="SemiBold"
                               Margin="12,0,14,0" VerticalAlignment="Center"/>
                    <materialDesign:PackIcon Kind="ChevronDown" Width="22" Height="22" VerticalAlignment="Center"/>
                </StackPanel>
            </ToggleButton>
            <Popup IsOpen="{Binding IsDatePickerOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=DateButton}"
                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True" VerticalOffset="4">
                <Border Background="White" CornerRadius="6" BorderBrush="#C9D6E8" BorderThickness="1" Padding="6">
                    <StackPanel>
                        <Calendar PreviewMouseUp="Calendar_PreviewMouseUp"
                                  materialDesign:CalendarAssist.HeaderBackground="#1D4F96"
                                  materialDesign:CalendarAssist.SelectionColor="#1D4F96" SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                  DisplayDate="{Binding SelectedDate, Mode=OneWay}"/>
                        <Button Content="Hôm nay" Command="{Binding GoToTodayCommand}"
                                Style="{StaticResource MaterialDesignFlatButton}" HorizontalAlignment="Stretch" Foreground="#1D4F96"/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <!-- ===== Cả ngày / Ca 1 / Ca 2 ... (theo cài đặt ca đang dùng) ===== -->
        <ListBox ItemsSource="{Binding ScopeOptions}" SelectedItem="{Binding SelectedScope, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource ScopeItem}" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" Margin="0,0,16,0">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TimeRange}" FontSize="14" HorizontalAlignment="Center"
                                   Visibility="{Binding HasTimeRange, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ===== Cài đặt (chuyển tới Cài đặt > Nhóm model, cần quyền Admin) ===== -->
        <Button Style="{StaticResource SettingButton}" ToolTip="Cài đặt nhóm model / kế hoạch (cần đăng nhập Admin)"
                Command="{Binding DataContext.OpenModelGroupSettingCommand, RelativeSource={RelativeSource AncestorType=Window}}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="Cog" Width="24" Height="24" VerticalAlignment="Center"/>
                <TextBlock Text="Cài đặt" FontSize="17" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
