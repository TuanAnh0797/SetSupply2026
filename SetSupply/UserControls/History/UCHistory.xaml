<UserControl x:Class="SetSupply.UserControls.History.UCHistory"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SetSupply.UserControls.History"
             mc:Ignorable="d" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- ========== DATAGRID SHARED STYLES ========== -->
        <Style x:Key="ShiftColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#5C6BC0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridColumnHeader">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                            <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Width="2" 
                                   Opacity="0" Cursor="SizeWE"/>
                            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="2" 
                                   Opacity="0" Cursor="SizeWE"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShiftCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" 
                                              HorizontalAlignment="Center"
                                              TextElement.Foreground="Black"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E8EAF6"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ShiftRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ModelName}" Value="TỔNG">
                    <Setter Property="Background" Value="#C8E6C9"/>
                    <Setter Property="Foreground" Value="#1B5E20"/>
                    <Setter Property="FontWeight" Value="ExtraBold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="MinHeight" Value="42"/>
                    <Setter Property="BorderBrush" Value="#43A047"/>
                    <Setter Property="BorderThickness" Value="0,3,0,0"/>
                </DataTrigger>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#FAFAFA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HistoryTabItemStyle" TargetType="TabItem">
            <Setter Property="Background" Value="#ECEFF1"/>
            <Setter Property="Foreground" Value="#455A64"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" 
                                Background="{TemplateBinding Background}"
                                BorderThickness="0,0,0,3"
                                BorderBrush="Transparent"
                                CornerRadius="8,8,0,0"
                                Padding="0">
                            <ContentPresenter x:Name="ContentSite"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              ContentSource="Header"
                                              Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#5C6BC0"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#5C6BC0"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#7986CB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="White" Margin="10,0,10,10" CornerRadius="5">
        <Border.Effect>
            <DropShadowEffect Color="Gray" Direction="315" ShadowDepth="4" 
                              BlurRadius="10" Opacity="0.5"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ========== HEADER: DatePicker + Navigation ========== -->
            <Border Grid.Row="0" Background="#F5F5F5" CornerRadius="5,5,0,0" Padding="15,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                 

                    <!-- Giữa: Date Navigation -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Nút ngày trước -->
                        <Button Command="{Binding GoToPreviousDayCommand}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Width="36" Height="36" Margin="0,0,5,0"
                                ToolTip="Ngày trước">
                            <materialDesign:PackIcon Kind="ChevronLeft" Width="24" Height="24"/>
                        </Button>

                        <!-- DatePicker -->
                        <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                    Width="160"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"
                                    materialDesign:HintAssist.Hint="Chọn ngày"
                                    Margin="5,0"/>

                        <!-- Nút ngày sau -->
                        <Button Command="{Binding GoToNextDayCommand}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Width="36" Height="36" Margin="5,0,10,0"
                                ToolTip="Ngày sau">
                            <materialDesign:PackIcon Kind="ChevronRight" Width="24" Height="24"/>
                        </Button>

                        <!-- Nút Hôm Nay -->
                        <Button Command="{Binding GoToTodayCommand}"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Height="36" Padding="12,0"
                                Foreground="#5C6BC0" BorderBrush="#5C6BC0"
                                ToolTip="Về hôm nay">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarToday" Width="16" Height="16" 
                                                         Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Hôm Nay" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Bên phải: Status + Refresh -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Tổng sản lượng ngày -->
                        <Border Background="#E8EAF6" CornerRadius="5" Padding="12,6" Margin="0,0,10,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Package" Width="18" Height="18" 
                                                         Foreground="#303F9F" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Tổng ngày:" FontSize="13" Foreground="#455A64" 
                                           VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="{Binding DailyTotalOutput}" FontSize="16" FontWeight="Bold" 
                                           Foreground="#303F9F" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Loading indicator -->
                        <ProgressBar IsIndeterminate="True" Width="80" Height="4"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     Margin="0,0,10,0"/>

                        <!-- Nút Refresh -->
                        <Button Command="{Binding RefreshDataCommand}"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Width="36" Height="36"
                                ToolTip="Tải lại dữ liệu">
                            <materialDesign:PackIcon Kind="Refresh" Width="22" Height="22" Foreground="#5C6BC0"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========== CONTENT ========== -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Tab Control 3 ca -->
                <TabControl Grid.Row="0" 
                            Margin="0"
                            Background="#FAFAFA"
                            SelectedIndex="{Binding SelectedTabIndex}"
                            ItemContainerStyle="{StaticResource HistoryTabItemStyle}">

                    <!-- ========== CA 1 ========== -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Margin="12,8">
                                <materialDesign:PackIcon Kind="WhiteBalanceSunny" Width="18" Height="18" 
                                                         Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Shift1.ShiftName}" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Shift1.TimeRange, StringFormat=' ({0})'}" FontSize="12" 
                                           VerticalAlignment="Center" Opacity="0.8" Margin="4,0,0,0"/>
                            </StackPanel>
                        </TabItem.Header>

                        <Grid Margin="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Summary Cards -->
                            <StackPanel Grid.Column="0" Margin="0,0,15,0" VerticalAlignment="Top">
                                <materialDesign:Card Margin="0,0,0,12" Background="#00796B" UniformCornerRadius="10" Width="220">
                                    <StackPanel Margin="18,14">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <materialDesign:PackIcon Kind="ChartLine" Width="22" Height="22" Foreground="White" Margin="0,0,8,0"/>
                                            <TextBlock Text="Tổng Sản Lượng" Foreground="White" FontSize="13" VerticalAlignment="Center" Opacity="0.95"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Shift1.TotalOutput}" Foreground="White" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </materialDesign:Card>

                                <materialDesign:Card Margin="0,0,0,12" Background="#0288D1" UniformCornerRadius="10" Width="220">
                                    <StackPanel Margin="18,14">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <materialDesign:PackIcon Kind="SpeedometerMedium" Width="22" Height="22" Foreground="White" Margin="0,0,8,0"/>
                                            <TextBlock Text="Trung Bình/Giờ" Foreground="White" FontSize="13" VerticalAlignment="Center" Opacity="0.95"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Shift1.Average}" Foreground="White" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </materialDesign:Card>

                                <materialDesign:Card Margin="0,0,0,12" Background="#43A047" UniformCornerRadius="10" Width="220">
                                    <StackPanel Margin="18,14">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <materialDesign:PackIcon Kind="TrendingUp" Width="22" Height="22" Foreground="White" Margin="0,0,8,0"/>
                                            <TextBlock Text="Giờ Cao Nhất" Foreground="White" FontSize="13" VerticalAlignment="Center" Opacity="0.95"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Shift1.MaxHour}" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Bottom"/>
                                            <TextBlock Text=" - " Foreground="White" FontSize="16" Margin="5,0" VerticalAlignment="Bottom"/>
                                            <TextBlock Text="{Binding Shift1.MaxOutput}" Foreground="White" FontSize="28" FontWeight="Bold" VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                    </StackPanel>
                                </materialDesign:Card>

                                <materialDesign:Card Background="#E53935" UniformCornerRadius="10" Width="220">
                                    <StackPanel Margin="18,14">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <materialDesign:PackIcon Kind="TrendingDown" Width="22" Height="22" Foreground="White" Margin="0,0,8,0"/>
                                            <TextBlock Text="Giờ Thấp Nhất" Foreground="White" FontSize="13" VerticalAlignment="Center" Opacity="0.95"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Shift1.MinHour}" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Bottom"/>
                                            <TextBlock Text=" - " Foreground="White" FontSize="16" Margin="5,0" VerticalAlignment="Bottom"/>
                                            <TextBlock Text="{Binding Shift1.MinOutput}" Foreground="White" FontSize="28" FontWeight="Bold" VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                    </StackPanel>
                                </materialDesign:Card>
                            </StackPanel>

                            <DataGrid x:Name="Shift1DataGrid"
                                      Grid.Column="1"
                                      ItemsSource="{Binding Shift1.Data}"
                                      AutoGenerateColumns="False" 
                                      CanUserAddRows="False" 
                                      IsReadOnly="True"
                                      HeadersVisibility="Column" 
                                      GridLinesVisibility="All"
                                      AlternationCount="2"
                                  RowHeight="35" 
                                      ColumnHeaderHeight="40"
                                      Background="White" 
                                      BorderBrush="#E0E0E0" 
                                      BorderThickness="1"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      ColumnHeaderStyle="{StaticResource ShiftColumnHeaderStyle}"
                                      CellStyle="{StaticResource ShiftCellStyle}"
                                      RowStyle="{StaticResource ShiftRowStyle}"/>
                        </Grid>
                    </TabItem>

                    <!-- ========== CA 2 ========== -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Margin="12,8">
                                <materialDesign:PackIcon Kind="WeatherSunset" Width="18" Height="18" 
                                                         Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Shift2.ShiftName}" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Shift2.TimeRange, StringFormat=' ({0})'}" FontSize="12" 
                                           VerticalAlignment="Center" Opacity="0.8" Margin="4,0,0,0"/>
                            </StackPanel>
                        </TabItem.Header>

                        <Grid Margin="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,15,0" VerticalAlignment="Top">
                                <materialDesign:Card Margin="0,0,0,12" Background="#00796B" UniformCornerRadius="10" Width="220">
                                    <StackPanel Margin="18,14">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <materialDesign:PackIcon Kind="ChartLine" Width="22" Height="22" Foreground="White" Margin="0,0,8,0"/>
                                            <TextBlock Text="Tổng Sản Lượng" Foreground="White" FontSize="13" VerticalAlignment="Center" Opacity="0.95"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Shift2.TotalOutput}" Foreground="White" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </materialDesign:Card>

                                <materialDesign:Card Margin="0,0,0,12" Background="#0288D1" UniformCornerRadius="10" Width="220">
                                    <StackPanel Margin="18,14">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <materialDesign:PackIcon Kind="SpeedometerMedium" Width="22" Height="22" Foreground="White" Margin="0,0,8,0"/>
                                            <TextBlock Text="Trung Bình/Giờ" Foreground="White" FontSize="13" VerticalAlignment="Center" Opacity="0.95"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Shift2.Average}" Foreground="White" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </materialDesign:Card>

                                <materialDesign:Card Margin="0,0,0,12" Background="#43A047" UniformCornerRadius="10" Width="220">
                                    <StackPanel Margin="18,14">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <materialDesign:PackIcon Kind="TrendingUp" Width="22" Height="22" Foreground="White" Margin="0,0,8,0"/>
                                            <TextBlock Text="Giờ Cao Nhất" Foreground="White" FontSize="13" VerticalAlignment="Center" Opacity="0.95"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Shift2.MaxHour}" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Bottom"/>
                                            <TextBlock Text=" - " Foreground="White" FontSize="16" Margin="5,0" VerticalAlignment="Bottom"/>
                                            <TextBlock Text="{Binding Shift2.MaxOutput}" Foreground="White" FontSize="28" FontWeight="Bold" VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                    </StackPanel>
                                </materialDesign:Card>

                                <materialDesign:Card Background="#E53935" UniformCornerRadius="10" Width="220">
                                    <StackPanel Margin="18,14">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <materialDesign:PackIcon Kind="TrendingDown" Width="22" Height="22" Foreground="White" Margin="0,0,8,0"/>
                                            <TextBlock Text="Giờ Thấp Nhất" Foreground="White" FontSize="13" VerticalAlignment="Center" Opacity="0.95"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Shift2.MinHour}" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Bottom"/>
                                            <TextBlock Text=" - " Foreground="White" FontSize="16" Margin="5,0" VerticalAlignment="Bottom"/>
                                            <TextBlock Text="{Binding Shift2.MinOutput}" Foreground="White" FontSize="28" FontWeight="Bold" VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                    </StackPanel>
                                </materialDesign:Card>
                            </StackPanel>

                            <DataGrid x:Name="Shift2DataGrid"
                                      Grid.Column="1"
                                      ItemsSource="{Binding Shift2.Data}"
                                      AutoGenerateColumns="False" 
                                      CanUserAddRows="False" 
                                      IsReadOnly="True"
                                      HeadersVisibility="Column" 
                                      GridLinesVisibility="All"
                                      AlternationCount="2"
                                  RowHeight="35" 
                                      ColumnHeaderHeight="40"
                                      Background="White" 
                                      BorderBrush="#E0E0E0" 
                                      BorderThickness="1"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      ColumnHeaderStyle="{StaticResource ShiftColumnHeaderStyle}"
                                      CellStyle="{StaticResource ShiftCellStyle}"
                                      RowStyle="{StaticResource ShiftRowStyle}"/>
                        </Grid>
                    </TabItem>

                    <!-- ========== CA 3 ========== -->
                    <TabItem>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal" Margin="12,8">
                                <materialDesign:PackIcon Kind="WeatherNight" Width="18" Height="18" 
                                                         Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Shift3.ShiftName}" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Shift3.TimeRange, StringFormat=' ({0})'}" FontSize="12" 
                                           VerticalAlignment="Center" Opacity="0.8" Margin="4,0,0,0"/>
                            </StackPanel>
                        </TabItem.Header>

                        <Grid Margin="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,15,0" VerticalAlignment="Top">
                                <materialDesign:Card Margin="0,0,0,12" Background="#00796B" UniformCornerRadius="10" Width="220">
                                    <StackPanel Margin="18,14">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <materialDesign:PackIcon Kind="ChartLine" Width="22" Height="22" Foreground="White" Margin="0,0,8,0"/>
                                            <TextBlock Text="Tổng Sản Lượng" Foreground="White" FontSize="13" VerticalAlignment="Center" Opacity="0.95"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Shift3.TotalOutput}" Foreground="White" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </materialDesign:Card>

                                <materialDesign:Card Margin="0,0,0,12" Background="#0288D1" UniformCornerRadius="10" Width="220">
                                    <StackPanel Margin="18,14">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <materialDesign:PackIcon Kind="SpeedometerMedium" Width="22" Height="22" Foreground="White" Margin="0,0,8,0"/>
                                            <TextBlock Text="Trung Bình/Giờ" Foreground="White" FontSize="13" VerticalAlignment="Center" Opacity="0.95"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Shift3.Average}" Foreground="White" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </materialDesign:Card>

                                <materialDesign:Card Margin="0,0,0,12" Background="#43A047" UniformCornerRadius="10" Width="220">
                                    <StackPanel Margin="18,14">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <materialDesign:PackIcon Kind="TrendingUp" Width="22" Height="22" Foreground="White" Margin="0,0,8,0"/>
                                            <TextBlock Text="Giờ Cao Nhất" Foreground="White" FontSize="13" VerticalAlignment="Center" Opacity="0.95"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Shift3.MaxHour}" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Bottom"/>
                                            <TextBlock Text=" - " Foreground="White" FontSize="16" Margin="5,0" VerticalAlignment="Bottom"/>
                                            <TextBlock Text="{Binding Shift3.MaxOutput}" Foreground="White" FontSize="28" FontWeight="Bold" VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                    </StackPanel>
                                </materialDesign:Card>

                                <materialDesign:Card Background="#E53935" UniformCornerRadius="10" Width="220">
                                    <StackPanel Margin="18,14">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <materialDesign:PackIcon Kind="TrendingDown" Width="22" Height="22" Foreground="White" Margin="0,0,8,0"/>
                                            <TextBlock Text="Giờ Thấp Nhất" Foreground="White" FontSize="13" VerticalAlignment="Center" Opacity="0.95"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Shift3.MinHour}" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Bottom"/>
                                            <TextBlock Text=" - " Foreground="White" FontSize="16" Margin="5,0" VerticalAlignment="Bottom"/>
                                            <TextBlock Text="{Binding Shift3.MinOutput}" Foreground="White" FontSize="28" FontWeight="Bold" VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                    </StackPanel>
                                </materialDesign:Card>
                            </StackPanel>

                            <DataGrid x:Name="Shift3DataGrid"
                                      Grid.Column="1"
                                      ItemsSource="{Binding Shift3.Data}"
                                      AutoGenerateColumns="False" 
                                      CanUserAddRows="False" 
                                      IsReadOnly="True"
                                      HeadersVisibility="Column" 
                                      GridLinesVisibility="All"
                                      AlternationCount="2"
                                  RowHeight="35" 
                                      ColumnHeaderHeight="40"
                                      Background="White" 
                                      BorderBrush="#E0E0E0" 
                                      BorderThickness="1"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      ColumnHeaderStyle="{StaticResource ShiftColumnHeaderStyle}"
                                      CellStyle="{StaticResource ShiftCellStyle}"
                                      RowStyle="{StaticResource ShiftRowStyle}"/>
                        </Grid>
                    </TabItem>
                </TabControl>

                <!-- ========== LỊCH SỬ CÀI ĐẶT CA (Toggle Panel) ========== -->
                <Border Grid.Row="1" Background="#FAFAFA"
                        Visibility="{Binding HasShiftSettingHistory, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <!-- Header Button -->
                        <ToggleButton x:Name="HistoryToggle"
                                      IsChecked="False"
                                      HorizontalContentAlignment="Left"
                                      Background="Transparent"
                                      BorderThickness="0,1,0,0"
                                      BorderBrush="#E0E0E0"
                                      Padding="15,8"
                                      Cursor="Hand">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="ClockAlert" Width="20" Height="20" 
                                                                                 Foreground="#FF6F00" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Lịch Sử Thay Đổi Cài Đặt Ca" FontSize="14" FontWeight="SemiBold" 
                                                                   Foreground="#455A64" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <materialDesign:PackIcon x:Name="ArrowIcon" Kind="ChevronDown" 
                                                                                 Width="20" Height="20" Foreground="#757575" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="ArrowIcon" Property="Kind" Value="ChevronUp"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#F0F0F0"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>

                        <!-- Collapsible Content -->
                        <DataGrid ItemsSource="{Binding ShiftSettingHistories}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  RowHeight="32"
                                  MaxHeight="200"
                                  Margin="15,5,15,10"
                                  Background="White"
                                  BorderBrush="#E0E0E0"
                                  BorderThickness="1"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column">
                            <DataGrid.Style>
                                <Style TargetType="DataGrid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=HistoryToggle}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Style>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#FF6F00"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="BorderBrush" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ca" Binding="{Binding ShiftName}" Width="80"/>
                                <DataGridTextColumn Header="Thời Gian Ca" Binding="{Binding TimeRange}" Width="140"/>
                                <DataGridTextColumn Header="Trạng Thái" Binding="{Binding IsUseText}" Width="120"/>
                                <DataGridTextColumn Header="Thay Đổi Lúc" Binding="{Binding ChangedAt}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
