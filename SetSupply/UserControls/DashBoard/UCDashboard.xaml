<UserControl x:Class="SetSupply.UserControls.DashBoard.UCDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SetSupply.UserControls.DashBoard"
             mc:Ignorable="d" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <Border Background="White" Margin="8,0,8,8" CornerRadius="5">
        <Border.Effect>
            <DropShadowEffect Color="Gray" Direction="315" ShadowDepth="3" BlurRadius="8" Opacity="0.4"/>
        </Border.Effect>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== HEADER ===== -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!--<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="DASHBOARD" FontSize="16" FontWeight="Bold" Foreground="#1565C0"/>
                    <TextBlock Text="{Binding CurrentShiftName, StringFormat=' — {0}'}" FontSize="13" 
                               Foreground="#455A64" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>-->

                <!--<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastUpdateTime, StringFormat='Cập nhật: {0}'}" FontSize="10" 
                               Foreground="#90A4AE" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Command="{Binding RefreshDataCommand}"
                            Style="{StaticResource MaterialDesignIconButton}"
                            Width="28" Height="28" Padding="0" ToolTip="Làm mới">
                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Foreground="#1565C0"/>
                    </Button>
                </StackPanel>-->
            </Grid>

            <!-- ===== SUMMARY CARDS ===== -->
            <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,8">
                <!-- Tổng ngày -->
                <Border Background="#E3F2FD" CornerRadius="6" Margin="0,0,4,0" Padding="8,6">
                    <StackPanel>
                        <TextBlock Text="TỔNG NGÀY" FontSize="9" Foreground="#1565C0" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding TodayTotalOutput}" FontSize="22" FontWeight="Bold" Foreground="#0D47A1"/>
                    </StackPanel>
                </Border>

                <!-- Ca 1 -->
                <Border Background="#E0F2F1" CornerRadius="6" Margin="2,0" Padding="8,6">
                    <StackPanel>
                        <TextBlock Text="CA 1" FontSize="9" Foreground="#00796B" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Shift1Output}" FontSize="22" FontWeight="Bold" Foreground="#004D40"/>
                    </StackPanel>
                </Border>

                <!-- Ca 2 -->
                <Border Background="#FFF3E0" CornerRadius="6" Margin="2,0" Padding="8,6">
                    <StackPanel>
                        <TextBlock Text="CA 2" FontSize="9" Foreground="#FF6F00" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Shift2Output}" FontSize="22" FontWeight="Bold" Foreground="#E65100"/>
                    </StackPanel>
                </Border>

                <!-- Ca 3 -->
                <Border Background="#E8EAF6" CornerRadius="6" Margin="2,0" Padding="8,6">
                    <StackPanel>
                        <TextBlock Text="CA 3" FontSize="9" Foreground="#303F9F" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Shift3Output}" FontSize="22" FontWeight="Bold" Foreground="#1A237E"/>
                    </StackPanel>
                </Border>

                <!-- Giờ hiện tại -->
                <Border Background="#F3E5F5" CornerRadius="6" Margin="4,0,0,0" Padding="8,6">
                    <StackPanel>
                        <TextBlock Text="GIỜ NÀY" FontSize="9" Foreground="#7B1FA2" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CurrentHourOutput}" FontSize="22" FontWeight="Bold" Foreground="#4A148C"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ===== CHARTS ===== -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="2.8*"/>
                </Grid.ColumnDefinitions>

                <!-- Bar Chart: So sánh 3 ca -->
                <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" 
                        Margin="0,0,4,0" Padding="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="So sánh 3 ca" FontSize="11" FontWeight="SemiBold" 
                                   Foreground="#455A64" Margin="2,0,0,4"/>

                        <lvc:CartesianChart Grid.Row="1"
                                            Series="{Binding ShiftComparisonSeries}"
                                            XAxes="{Binding ShiftComparisonXAxes}"
                                            YAxes="{Binding ShiftComparisonYAxes}"
                                            TooltipPosition="Top"
                                            AnimationsSpeed="00:00:00.3"/>
                    </Grid>
                </Border>

                <!-- Line Chart: Sản lượng theo giờ -->
                <Border Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" 
                        Margin="4,0,0,0" Padding="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Sản lượng theo giờ" FontSize="11" FontWeight="SemiBold" 
                                   Foreground="#455A64" Margin="2,0,0,4"/>

                        <lvc:CartesianChart Grid.Row="1"
                                            Series="{Binding HourlyOutputSeries}"
                                            XAxes="{Binding HourlyOutputXAxes}"
                                            YAxes="{Binding HourlyOutputYAxes}"
                                            TooltipPosition="Top"
                                            LegendPosition="Right"
                                            AnimationsSpeed="00:00:00.3"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
