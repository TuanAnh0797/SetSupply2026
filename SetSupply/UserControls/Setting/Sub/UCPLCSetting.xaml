<UserControl x:Class="APP.UserControls.Setting.Sub.UCPLCSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:APP.UserControls.Setting.Sub"
             mc:Ignorable="d" 
              xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Settings -->
        <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Left">
            <StackPanel.Resources>
                <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                    <Setter Property="Margin" Value="0,0,0,6"/>
                    <Setter Property="Width" Value="200"/>
                    <Setter Property="Padding" Value="4,2"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Height" Value="34"/>
                </Style>
                <Style x:Key="FieldLabel" TargetType="TextBlock">
                    <Setter Property="Width" Value="160"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                    <Setter Property="Foreground" Value="#455A64"/>
                </Style>
            </StackPanel.Resources>

            <!-- Header -->
            <Border BorderBrush="#1565C0" BorderThickness="0,0,0,1" Padding="0,0,0,6" Margin="0,0,0,10">
                <TextBlock Text="CÀI ĐẶT KẾT NỐI PLC" FontSize="14" FontWeight="Bold" Foreground="#1565C0"/>
            </Border>

            <!-- Kết nối -->
            <TextBlock Text="Kết nối" FontSize="12" FontWeight="SemiBold" Foreground="#00796B" Margin="0,0,0,6"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="IP Address" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding IPAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="IP Address"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Port" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Port" Width="100"/>
            </StackPanel>

            <!-- Địa chỉ dữ liệu -->
            <TextBlock Text="Địa chỉ dữ liệu" FontSize="12" FontWeight="SemiBold" Foreground="#FF6F00" Margin="0,10,0,6"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Address Data (DM)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding AddressData, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Address Data (DM)"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Total Register Data" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding TotalRegisterData, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Total Register Data"/>
            </StackPanel>

            <!-- Địa chỉ điều khiển -->
            <TextBlock Text="Địa chỉ điều khiển" FontSize="12" FontWeight="SemiBold" Foreground="#303F9F" Margin="0,10,0,6"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Address Trigger (M)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding AddressTrigger, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Address Trigger (M)"/>
            </StackPanel>

            <!--<StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Address Confirm Final (M)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding AddressConfirmFinalReadData, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Address Confirm Final (M)"/>
            </StackPanel>-->

            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock Text="Address Alive (M)" Style="{StaticResource FieldLabel}"/>
                <TextBox Text="{Binding AddressAlive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Address Alive (M)"/>
            </StackPanel>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Command="{Binding ReloadCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Height="34" Padding="14,0" Margin="0,0,8,0"
                    Foreground="#546E7A" BorderBrush="#B0BEC5">
                <TextBlock Text="Tải Lại" FontSize="12" FontWeight="SemiBold"/>
            </Button>

            <Button Command="{Binding SaveCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Height="34" Padding="18,0"
                    Background="#1565C0" Foreground="White">
                <TextBlock Text="Lưu Cài Đặt" FontSize="12" FontWeight="SemiBold"/>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
