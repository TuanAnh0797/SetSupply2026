<UserControl x:Class="SetSupply.UserControls.Setting.Sub.UCShiftSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SetSupply.UserControls.Setting.Sub"
             mc:Ignorable="d" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <UserControl.Resources>
        <!-- Danh sách giờ 0-23 -->
        <x:Array x:Key="HourItems" Type="sys:Int32">
            <sys:Int32>0</sys:Int32>
            <sys:Int32>1</sys:Int32>
            <sys:Int32>2</sys:Int32>
            <sys:Int32>3</sys:Int32>
            <sys:Int32>4</sys:Int32>
            <sys:Int32>5</sys:Int32>
            <sys:Int32>6</sys:Int32>
            <sys:Int32>7</sys:Int32>
            <sys:Int32>8</sys:Int32>
            <sys:Int32>9</sys:Int32>
            <sys:Int32>10</sys:Int32>
            <sys:Int32>11</sys:Int32>
            <sys:Int32>12</sys:Int32>
            <sys:Int32>13</sys:Int32>
            <sys:Int32>14</sys:Int32>
            <sys:Int32>15</sys:Int32>
            <sys:Int32>16</sys:Int32>
            <sys:Int32>17</sys:Int32>
            <sys:Int32>18</sys:Int32>
            <sys:Int32>19</sys:Int32>
            <sys:Int32>20</sys:Int32>
            <sys:Int32>21</sys:Int32>
            <sys:Int32>22</sys:Int32>
            <sys:Int32>23</sys:Int32>
        </x:Array>

        <x:Array x:Key="MinuteItems" Type="sys:Int32">
            <sys:Int32>0</sys:Int32>
            <sys:Int32>5</sys:Int32>
            <sys:Int32>10</sys:Int32>
            <sys:Int32>15</sys:Int32>
            <sys:Int32>20</sys:Int32>
            <sys:Int32>25</sys:Int32>
            <sys:Int32>30</sys:Int32>
            <sys:Int32>35</sys:Int32>
            <sys:Int32>40</sys:Int32>
            <sys:Int32>45</sys:Int32>
            <sys:Int32>50</sys:Int32>
            <sys:Int32>55</sys:Int32>
        </x:Array>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="90"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#455A64"/>
        </Style>

        <Style x:Key="TimeComboBox" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
            <Setter Property="Width" Value="70"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,3,0"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <Style x:Key="TimeSeparator" TargetType="TextBlock">
            <Setter Property="Text" Value=":"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Foreground" Value="#78909C"/>
        </Style>
        <Style x:Key="BreakBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 1 dòng giờ nghỉ: bắt đầu - kết thúc, tên, nút xóa -->
        <DataTemplate x:Key="BreakTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                <TextBox Style="{StaticResource BreakBox}" Width="62" HorizontalContentAlignment="Center"
                         Text="{Binding StartText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Giờ bắt đầu nghỉ (HH:mm)"/>
                <TextBlock Text="–" FontSize="14" FontWeight="Bold" Foreground="#78909C" VerticalAlignment="Center" Margin="6,0"/>
                <TextBox Style="{StaticResource BreakBox}" Width="62" HorizontalContentAlignment="Center"
                         Text="{Binding EndText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Giờ kết thúc nghỉ (HH:mm)"/>
                <TextBox Style="{StaticResource BreakBox}" Width="150" Margin="8,0,0,0"
                         materialDesign:HintAssist.Hint="Tên (VD: Nghỉ trưa)"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                <Button Style="{StaticResource MaterialDesignIconButton}" Width="30" Height="30" Margin="4,0,0,0"
                        Foreground="#E53935" ToolTip="Xóa giờ nghỉ này"
                        Command="{Binding DataContext.RemoveBreakCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}">
                    <materialDesign:PackIcon Kind="CloseCircleOutline" Width="18" Height="18"/>
                </Button>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,5,0,5">

                <!-- ==================== CA 1 ==================== -->
                <materialDesign:Card Margin="0,0,0,6" Padding="12" UniformCornerRadius="6">
                    <StackPanel>
                        <!-- Header -->
                        <Border BorderBrush="#00796B" BorderThickness="0,0,0,1" Padding="0,0,0,6" Margin="0,0,0,6">
                            <TextBlock Text="CA 1 — CA SÁNG" FontSize="14" FontWeight="Bold" Foreground="#00796B"/>
                        </Border>

                        <!-- Giờ bắt đầu -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Giờ bắt đầu" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Style="{StaticResource TimeComboBox}"
                                      ItemsSource="{StaticResource HourItems}"
                                      SelectedValue="{Binding Shift1StartHour, Mode=TwoWay}"/>
                            <TextBlock Style="{StaticResource TimeSeparator}"/>
                            <ComboBox Style="{StaticResource TimeComboBox}"
                                      ItemsSource="{StaticResource MinuteItems}"
                                      SelectedValue="{Binding Shift1StartMinute, Mode=TwoWay}"/>
                        </StackPanel>

                        <!-- Giờ kết thúc -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Giờ kết thúc" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Style="{StaticResource TimeComboBox}"
                                      ItemsSource="{StaticResource HourItems}"
                                      SelectedValue="{Binding Shift1EndHour, Mode=TwoWay}"/>
                            <TextBlock Style="{StaticResource TimeSeparator}"/>
                            <ComboBox Style="{StaticResource TimeComboBox}"
                                      ItemsSource="{StaticResource MinuteItems}"
                                      SelectedValue="{Binding Shift1EndMinute, Mode=TwoWay}"/>
                        </StackPanel>

                        <!-- Thời gian hiển thị -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Thời gian" Style="{StaticResource FieldLabel}"/>
                            <Border Background="#E0F2F1" CornerRadius="4" Padding="8,3">
                                <TextBlock Text="{Binding Shift1TimeRange}" FontSize="13" FontWeight="Bold" Foreground="#00796B"/>
                            </Border>
                        </StackPanel>

                        <!-- Sử dụng ca -->
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="" Style="{StaticResource FieldLabel}"/>
                            <CheckBox IsChecked="{Binding Shift1IsUse, Mode=TwoWay}"
                                      Content="Sử dụng ca này"
                                      FontSize="12" FontWeight="SemiBold" Foreground="#00796B"/>
                        </StackPanel>

                        <!-- Giờ nghỉ: kế hoạch theo giờ chỉ chia cho thời gian làm việc -->
                        <Border BorderBrush="#E3E8EF" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Giờ nghỉ" Style="{StaticResource FieldLabel}"/>
                                    <Button Command="{Binding AddBreakCommand}" CommandParameter="1"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Padding="10,0"
                                            Foreground="#00796B" BorderBrush="#00796B">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="Thêm giờ nghỉ" FontSize="12" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Border Background="#E0F2F1" CornerRadius="4" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Shift1WorkText}" FontSize="12" FontWeight="SemiBold" Foreground="#00796B"/>
                                    </Border>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Shift1Breaks}" ItemTemplate="{StaticResource BreakTemplate}" Margin="90,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </materialDesign:Card>

                <!-- ==================== CA 2 ==================== -->
                <materialDesign:Card Margin="0,0,0,6" Padding="12" UniformCornerRadius="6">
                    <StackPanel>
                        <Border BorderBrush="#FF6F00" BorderThickness="0,0,0,1" Padding="0,0,0,6" Margin="0,0,0,6">
                            <TextBlock Text="CA 2 — CA CHIỀU" FontSize="14" FontWeight="Bold" Foreground="#FF6F00"/>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Giờ bắt đầu" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Style="{StaticResource TimeComboBox}"
                                      ItemsSource="{StaticResource HourItems}"
                                      SelectedValue="{Binding Shift2StartHour, Mode=TwoWay}"/>
                            <TextBlock Style="{StaticResource TimeSeparator}"/>
                            <ComboBox Style="{StaticResource TimeComboBox}"
                                      ItemsSource="{StaticResource MinuteItems}"
                                      SelectedValue="{Binding Shift2StartMinute, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Giờ kết thúc" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Style="{StaticResource TimeComboBox}"
                                      ItemsSource="{StaticResource HourItems}"
                                      SelectedValue="{Binding Shift2EndHour, Mode=TwoWay}"/>
                            <TextBlock Style="{StaticResource TimeSeparator}"/>
                            <ComboBox Style="{StaticResource TimeComboBox}"
                                      ItemsSource="{StaticResource MinuteItems}"
                                      SelectedValue="{Binding Shift2EndMinute, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Thời gian" Style="{StaticResource FieldLabel}"/>
                            <Border Background="#FFF3E0" CornerRadius="4" Padding="8,3">
                                <TextBlock Text="{Binding Shift2TimeRange}" FontSize="13" FontWeight="Bold" Foreground="#FF6F00"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="" Style="{StaticResource FieldLabel}"/>
                            <CheckBox IsChecked="{Binding Shift2IsUse, Mode=TwoWay}"
                                      Content="Sử dụng ca này"
                                      FontSize="12" FontWeight="SemiBold" Foreground="#FF6F00"/>
                        </StackPanel>

                        <!-- Giờ nghỉ: kế hoạch theo giờ chỉ chia cho thời gian làm việc -->
                        <Border BorderBrush="#E3E8EF" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Giờ nghỉ" Style="{StaticResource FieldLabel}"/>
                                    <Button Command="{Binding AddBreakCommand}" CommandParameter="2"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Padding="10,0"
                                            Foreground="#FF6F00" BorderBrush="#FF6F00">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="Thêm giờ nghỉ" FontSize="12" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Border Background="#FFF3E0" CornerRadius="4" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Shift2WorkText}" FontSize="12" FontWeight="SemiBold" Foreground="#FF6F00"/>
                                    </Border>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Shift2Breaks}" ItemTemplate="{StaticResource BreakTemplate}" Margin="90,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </materialDesign:Card>

                <!-- ==================== CA 3 ==================== -->
                <materialDesign:Card Padding="12" UniformCornerRadius="6">
                    <StackPanel>
                        <Border BorderBrush="#303F9F" BorderThickness="0,0,0,1" Padding="0,0,0,6" Margin="0,0,0,6">
                            <TextBlock Text="CA 3 — CA ĐÊM" FontSize="14" FontWeight="Bold" Foreground="#303F9F"/>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Giờ bắt đầu" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Style="{StaticResource TimeComboBox}"
                                      ItemsSource="{StaticResource HourItems}"
                                      SelectedValue="{Binding Shift3StartHour, Mode=TwoWay}"/>
                            <TextBlock Style="{StaticResource TimeSeparator}"/>
                            <ComboBox Style="{StaticResource TimeComboBox}"
                                      ItemsSource="{StaticResource MinuteItems}"
                                      SelectedValue="{Binding Shift3StartMinute, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Giờ kết thúc" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Style="{StaticResource TimeComboBox}"
                                      ItemsSource="{StaticResource HourItems}"
                                      SelectedValue="{Binding Shift3EndHour, Mode=TwoWay}"/>
                            <TextBlock Style="{StaticResource TimeSeparator}"/>
                            <ComboBox Style="{StaticResource TimeComboBox}"
                                      ItemsSource="{StaticResource MinuteItems}"
                                      SelectedValue="{Binding Shift3EndMinute, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Thời gian" Style="{StaticResource FieldLabel}"/>
                            <Border Background="#E8EAF6" CornerRadius="4" Padding="8,3">
                                <TextBlock Text="{Binding Shift3TimeRange}" FontSize="13" FontWeight="Bold" Foreground="#303F9F"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="" Style="{StaticResource FieldLabel}"/>
                            <CheckBox IsChecked="{Binding Shift3IsUse, Mode=TwoWay}"
                                      Content="Sử dụng ca này"
                                      FontSize="12" FontWeight="SemiBold" Foreground="#303F9F"/>
                        </StackPanel>

                        <!-- Giờ nghỉ: kế hoạch theo giờ chỉ chia cho thời gian làm việc -->
                        <Border BorderBrush="#E3E8EF" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Giờ nghỉ" Style="{StaticResource FieldLabel}"/>
                                    <Button Command="{Binding AddBreakCommand}" CommandParameter="3"
                                            Style="{StaticResource MaterialDesignOutlinedButton}" Height="28" Padding="10,0"
                                            Foreground="#303F9F" BorderBrush="#303F9F">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Plus" Width="14" Height="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="Thêm giờ nghỉ" FontSize="12" Margin="4,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Border Background="#E8EAF6" CornerRadius="4" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Shift3WorkText}" FontSize="12" FontWeight="SemiBold" Foreground="#303F9F"/>
                                    </Border>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Shift3Breaks}" ItemTemplate="{StaticResource BreakTemplate}" Margin="90,0,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </materialDesign:Card>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,8,0,0">

            <Button Command="{Binding ReloadCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Height="34" Padding="14,0" Margin="0,0,10,0"
                    Foreground="#546E7A" BorderBrush="#B0BEC5">
                <TextBlock Text="Tải Lại" FontSize="12" FontWeight="SemiBold"/>
            </Button>

            <Button Command="{Binding SaveCommand}"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Height="34" Padding="18,0"
                    Background="#00796B" Foreground="White">
                <TextBlock Text="Lưu Cài Đặt" FontSize="12" FontWeight="SemiBold"/>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>