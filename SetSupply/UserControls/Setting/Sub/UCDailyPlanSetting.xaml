<UserControl x:Class="SetSupply.UserControls.Setting.Sub.UCDailyPlanSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1200">

    <UserControl.Resources>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Background" Value="#1D4F96"/>
            <Setter Property="BorderBrush" Value="#1D4F96"/>
        </Style>
        <Style x:Key="HeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
            <Setter Property="Background" Value="#1D4F96"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Kế hoạch sản lượng theo ngày" FontSize="22" FontWeight="Bold"
                   Foreground="#1D4F96" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Ngày sản xuất" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <DatePicker SelectedDate="{Binding PlanDate}" Width="150" FontSize="15" VerticalAlignment="Center" Margin="0,0,20,0"
                        materialDesign:CalendarAssist.HeaderBackground="#1D4F96"/>

            <Button Style="{StaticResource ToolButton}" Command="{Binding SaveCommand}" Background="#2E7D32" BorderBrush="#2E7D32">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Lưu"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolButton}" Command="{Binding CopyPreviousCommand}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ContentCopy" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Copy từ ngày trước"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolButton}" Command="{Binding DeleteCommand}" Background="#E53935" BorderBrush="#E53935">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Delete" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Xóa kế hoạch ngày"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolButton}" Command="{Binding LoadCommand}" Background="#607D8B" BorderBrush="#607D8B">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Tải lại"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Import file kế hoạch / Export + Tự động import -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <Border Background="#F4F7FC" BorderBrush="#C9D6E8" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Command="{Binding ImportCommand}" Background="#00897B" BorderBrush="#00897B"
                            ToolTip="File kế hoạch sản xuất (sheet Daily revise): chỉ lấy dòng Plan của model NR-, số theo ca ở cột S.1 / S.2 / S.3">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileImport" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Import file kế hoạch..."/>
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Fill="#C9D6E8" Margin="6,4,16,4"/>
                    <TextBlock Text="Export từ" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker SelectedDate="{Binding ExportFrom}" Width="130" FontSize="14" VerticalAlignment="Center"
                                materialDesign:CalendarAssist.HeaderBackground="#1D4F96"/>
                    <TextBlock Text="đến" FontSize="14" VerticalAlignment="Center" Margin="10,0,8,0"/>
                    <DatePicker SelectedDate="{Binding ExportTo}" Width="130" FontSize="14" VerticalAlignment="Center" Margin="0,0,14,0"
                                materialDesign:CalendarAssist.HeaderBackground="#1D4F96"/>
                    <Button Style="{StaticResource ToolButton}" Command="{Binding ExportCommand}" Background="#00897B" BorderBrush="#00897B">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FileExport" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Export"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="Import: chỉ lấy dòng Plan của model NR-, cộng theo nhóm model. Export: Ngày | Nhóm model | Kế hoạch Ca 1..3."
                               FontSize="13" Foreground="#5B6B82" VerticalAlignment="Center" Margin="6,0,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#F1F8F4" BorderBrush="#B7DCC4" BorderThickness="1" CornerRadius="4" Padding="10,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding AutoImportEnabled}" Content="Tự động import file mới trong thư mục"
                                  FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <TextBox Text="{Binding AutoImportFolder, UpdateSourceTrigger=PropertyChanged}" Width="420" FontSize="14"
                                 VerticalAlignment="Center" materialDesign:HintAssist.Hint="Đường dẫn thư mục chứa file kế hoạch"/>
                        <Button Style="{StaticResource ToolButton}" Command="{Binding BrowseFolderCommand}" Background="#607D8B" BorderBrush="#607D8B"
                                Margin="8,0,16,0" Content="Chọn..."/>

                        <TextBlock Text="Sheet" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding PlanSheetName, UpdateSourceTrigger=PropertyChanged}" Width="150" FontSize="14"
                                 VerticalAlignment="Center" Margin="0,0,16,0"
                                 ToolTip="Tên sheet cần đọc trong file kế hoạch (để trống = tự tìm sheet đúng cấu trúc)"/>
                        <TextBlock Text="S.1 →" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox ItemsSource="{Binding ShiftChoices}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                  SelectedValue="{Binding ShiftForS1}" Width="80" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="S.2 →" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox ItemsSource="{Binding ShiftChoices}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                  SelectedValue="{Binding ShiftForS2}" Width="80" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="S.3 →" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox ItemsSource="{Binding ShiftChoices}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                  SelectedValue="{Binding ShiftForS3}" Width="80" FontSize="14" VerticalAlignment="Center" Margin="0,0,16,0"/>

                        <Button Style="{StaticResource ToolButton}" Command="{Binding SaveAutoImportCommand}" Background="#2E7D32" BorderBrush="#2E7D32">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Lưu cài đặt"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Command="{Binding ScanNowCommand}" Background="#0288D1" BorderBrush="#0288D1">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderSync" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Quét ngay"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="{Binding AutoImportStatus}" FontSize="13" FontWeight="SemiBold" Foreground="#1E7B34" Margin="0,6,0,0"/>
                    <TextBlock FontSize="12" Foreground="#5B6B82" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="Chỉ đọc sheet có tên ở ô Sheet (áp dụng cho cả Import thủ công); file không có sheet đó sẽ báo lỗi trong nhật ký. Mỗi phút (và ngay khi có file chép vào) chương trình kiểm tra thư mục; file .xlsx / .xlsm mới hoặc vừa bị thay đổi sẽ được import (file mới nhất được ghi sau cùng). S.1 / S.2 / S.3 → chọn ca tương ứng của chương trình (VD 2 ca: S.1 → Ca 1, S.3 → Ca 2)."/>

                    <Expander Header="Nhật ký import (30 lần gần nhất)" Margin="0,4,0,0" Padding="0" FontSize="13"
                              materialDesign:ExpanderAssist.HorizontalHeaderPadding="0,4">
                        <DataGrid ItemsSource="{Binding ImportLogs}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="170"
                                  HeadersVisibility="Column" FontSize="12" GridLinesVisibility="Horizontal"
                                  materialDesign:DataGridAssist.CellPadding="6,3" materialDesign:DataGridAssist.ColumnHeaderPadding="6,4">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Thời gian" Binding="{Binding ImportedAt, StringFormat=dd/MM/yyyy HH:mm:ss}" Width="140"/>
                                <DataGridTextColumn Header="Nguồn" Binding="{Binding Source}" Width="80"/>
                                <DataGridCheckBoxColumn Header="OK" Binding="{Binding Success}" Width="45"/>
                                <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="220"/>
                                <DataGridTextColumn Header="Ngày" Binding="{Binding DaysImported}" Width="55"/>
                                <DataGridTextColumn Header="Ghi chú" Binding="{Binding Message}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Expander>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="SemiBold" Foreground="#1D4F96" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ShiftInfoText}" FontSize="13" Foreground="#5B6B82" Margin="0,4,0,0"/>
            <TextBlock FontSize="13" Foreground="#5B6B82" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="• Danh sách nhóm lấy từ trang Model Group. Ngày chưa có kế hoạch: Home vẫn đếm sản lượng thực tế, cột kế hoạch hiện &quot;-&quot;. Chọn &quot;Cả ngày&quot; ở Home chỉ cộng kế hoạch các ca đang dùng."/>
        </StackPanel>

        <DataGrid Grid.Row="4" ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserSortColumns="False" SelectionMode="Single" HeadersVisibility="Column"
                  GridLinesVisibility="All" BorderBrush="#C9D6E8" BorderThickness="1" FontSize="15"
                  ColumnHeaderStyle="{StaticResource HeaderStyle}"
                  materialDesign:DataGridAssist.CellPadding="10,8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nhóm model" Binding="{Binding GroupName}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="Kế hoạch Ca 1" Binding="{Binding Shift1, UpdateSourceTrigger=PropertyChanged}" Width="170"/>
                <DataGridTextColumn Header="Kế hoạch Ca 2" Binding="{Binding Shift2, UpdateSourceTrigger=PropertyChanged}" Width="170"/>
                <DataGridTextColumn Header="Kế hoạch Ca 3" Binding="{Binding Shift3, UpdateSourceTrigger=PropertyChanged}" Width="170"/>
                <DataGridTextColumn Header="Tổng" Binding="{Binding Total, Mode=OneWay, StringFormat={}{0:#,0}}" IsReadOnly="True" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="5" Text="{Binding TotalText}" FontSize="15" FontWeight="Bold" Foreground="#15305A" Margin="0,10,0,0"/>
    </Grid>
</UserControl>
