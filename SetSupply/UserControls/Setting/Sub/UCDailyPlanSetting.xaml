<UserControl x:Class="SetSupply.UserControls.Setting.Sub.UCDailyPlanSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1200">

    <UserControl.Resources>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Background" Value="#1D4F96"/>
            <Setter Property="BorderBrush" Value="#1D4F96"/>
        </Style>
        <Style x:Key="HeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
            <Setter Property="Background" Value="#1D4F96"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Kế hoạch sản lượng theo ngày" FontSize="22" FontWeight="Bold"
                   Foreground="#1D4F96" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Ngày sản xuất" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <DatePicker SelectedDate="{Binding PlanDate}" Width="150" FontSize="15" VerticalAlignment="Center" Margin="0,0,20,0"
                        materialDesign:CalendarAssist.HeaderBackground="#1D4F96"/>

            <Button Style="{StaticResource ToolButton}" Command="{Binding SaveCommand}" Background="#2E7D32" BorderBrush="#2E7D32">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Lưu"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolButton}" Command="{Binding CopyPreviousCommand}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ContentCopy" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Copy từ ngày trước"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolButton}" Command="{Binding LoadDefaultCommand}" Background="#0288D1" BorderBrush="#0288D1">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Restore" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Điền kế hoạch mặc định"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolButton}" Command="{Binding DeleteCommand}" Background="#E53935" BorderBrush="#E53935">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Delete" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Xóa KH riêng"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolButton}" Command="{Binding LoadCommand}" Background="#607D8B" BorderBrush="#607D8B">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Tải lại"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="SemiBold" Foreground="#1D4F96" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ShiftInfoText}" FontSize="13" Foreground="#5B6B82" Margin="0,4,0,0"/>
            <TextBlock FontSize="13" Foreground="#5B6B82" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="• Danh sách nhóm lấy từ trang Model Group / Plan. Ngày không có kế hoạch riêng sẽ dùng kế hoạch mặc định của nhóm. Màn hình Home chọn &quot;Cả ngày&quot; chỉ cộng các ca đang dùng."/>
        </StackPanel>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserSortColumns="False" SelectionMode="Single" HeadersVisibility="Column"
                  GridLinesVisibility="All" BorderBrush="#C9D6E8" BorderThickness="1" FontSize="15"
                  ColumnHeaderStyle="{StaticResource HeaderStyle}"
                  materialDesign:DataGridAssist.CellPadding="10,8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nhóm model" Binding="{Binding GroupName}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="Kế hoạch Ca 1" Binding="{Binding Shift1, UpdateSourceTrigger=PropertyChanged}" Width="170"/>
                <DataGridTextColumn Header="Kế hoạch Ca 2" Binding="{Binding Shift2, UpdateSourceTrigger=PropertyChanged}" Width="170"/>
                <DataGridTextColumn Header="Kế hoạch Ca 3" Binding="{Binding Shift3, UpdateSourceTrigger=PropertyChanged}" Width="170"/>
                <DataGridTextColumn Header="Tổng" Binding="{Binding Total, Mode=OneWay, StringFormat={}{0:#,0}}" IsReadOnly="True" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="4" Text="{Binding TotalText}" FontSize="15" FontWeight="Bold" Foreground="#15305A" Margin="0,10,0,0"/>
    </Grid>
</UserControl>
