<UserControl x:Class="SetSupply.UserControls.Setting.Sub.UCModelGroupSetting"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1200">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Background" Value="#1D4F96"/>
            <Setter Property="BorderBrush" Value="#1D4F96"/>
        </Style>
        <Style x:Key="HeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
            <Setter Property="Background" Value="#1D4F96"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Nhóm model (gán từng model vào nhóm)" FontSize="22" FontWeight="Bold"
                   Foreground="#1D4F96" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Style="{StaticResource ToolButton}" Command="{Binding AddCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Thêm dòng"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding DeleteCommand}" Background="#E53935" BorderBrush="#E53935">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Delete" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Xóa dòng"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding SaveCommand}" Background="#2E7D32" BorderBrush="#2E7D32">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSave" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Lưu"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding LoadCommand}" Background="#607D8B" BorderBrush="#607D8B">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Tải lại"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding AddUnmappedModelsCommand}" Background="#0288D1" BorderBrush="#0288D1"
                        ToolTip="Thêm các model đã sản xuất 30 ngày gần nhất nhưng chưa có nhóm">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="PlaylistPlus" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Thêm model chưa có nhóm"/>
                    </StackPanel>
                </Button>

                <Rectangle Width="1" Fill="#C9D6E8" Margin="0,4,10,4"/>

                <Button Style="{StaticResource ToolButton}" Command="{Binding ImportCommand}" Background="#00897B" BorderBrush="#00897B">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileImport" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Import"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ExportCommand}" Background="#00897B" BorderBrush="#00897B">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FileExport" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Export"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Style="{StaticResource ToolButton}" Command="{Binding ChooseImageCommand}" Background="#6A1B9A" BorderBrush="#6A1B9A">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ImageEdit" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Chọn ảnh cho dòng đang chọn"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding ClearImageCommand}" Background="#8E6AA8" BorderBrush="#8E6AA8">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ImageRemove" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Bỏ ảnh"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolButton}" Command="{Binding OpenImageFolderCommand}" Background="#607D8B" BorderBrush="#607D8B">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FolderOpen" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Mở thư mục ảnh"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock FontSize="13" Foreground="#5B6B82" TextWrapping="Wrap">
                <Run Text="• Mỗi dòng gán 1 model vào 1 nhóm. Model chưa có trong bảng sẽ vào nhóm &quot;Khác&quot;. Thứ tự nhóm trên Home theo cột Thứ tự."/>
                <LineBreak/>
                <Run Text="• Import / Export: file Excel hoặc CSV, cột Nhóm model | Model | Đường dẫn ảnh (Import xong bấm Lưu)."/>
                <LineBreak/>
                <Run Text="• Đường dẫn ảnh: đường dẫn đầy đủ (VD D:\Anh\NR-C33ES2-C.png) hoặc tên file trong thư mục "/>
                <Run Text="{Binding ImageFolder, Mode=OneWay}" FontWeight="SemiBold"/>
                <Run Text=". Để trống: tự tìm &lt;tên model&gt;.png hoặc &lt;tên nhóm&gt;.png trong thư mục đó."/>
            </TextBlock>
        </StackPanel>

        <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" HeadersVisibility="Column" RowHeight="44"
                  GridLinesVisibility="All" BorderBrush="#C9D6E8" BorderThickness="1" FontSize="15"
                  ColumnHeaderStyle="{StaticResource HeaderStyle}"
                  materialDesign:DataGridAssist.CellPadding="10,6">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Thứ tự" Binding="{Binding SortOrder}" Width="80"/>
                <DataGridTextColumn Header="Nhóm model" Binding="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
                <DataGridTextColumn Header="Model" Binding="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}" Width="240"/>
                <DataGridTemplateColumn Header="Ảnh" Width="70" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Width="30" Height="34" HorizontalAlignment="Center">
                                <Image Source="{Binding Preview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <materialDesign:PackIcon Kind="AlertCircle" Foreground="#E53935" Width="18" Height="18"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         ToolTip="Không tìm thấy file ảnh"
                                                         Visibility="{Binding ImageMissing, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Đường dẫn ảnh" Binding="{Binding ImagePath, UpdateSourceTrigger=LostFocus}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="{Binding SummaryText}" FontSize="14" FontWeight="SemiBold" Foreground="#15305A" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
