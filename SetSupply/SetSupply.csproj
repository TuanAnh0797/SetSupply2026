<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x86;x64</Platforms>
    <ApplicationIcon>checklist.ico</ApplicationIcon>
    <AssemblyName>SetSupply</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="UserControls\Setting\ChildrenUC\**" />
    <EmbeddedResource Remove="UserControls\Setting\ChildrenUC\**" />
    <None Remove="UserControls\Setting\ChildrenUC\**" />
    <Page Remove="UserControls\Setting\ChildrenUC\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="App.xaml.cs~RF738d03fd.TMP" />
    <None Remove="Resources\Image\database.png" />
    <None Remove="Resources\Image\material.png" />
    <None Remove="Resources\Image\plc.png" />
    <None Remove="Resources\Image\printer.png" />
    <None Remove="Resources\Image\schedule.png" />
    <None Remove="Resources\Image\worker.png" />
  </ItemGroup>

  <ItemGroup>
    <Page Remove="Resources\Language\StringResources.en.xaml" />
    <Page Remove="Resources\Language\StringResources.vi.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Resources\Database\" />
    <Folder Include="UserControls\Help\ChildrenUC\" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="checklist.ico" />
    <Content Include="Resources\Language\StringResources.en.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Resources\Language\StringResources.vi.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
	  <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
	  <PackageReference Include="LiveChartsCore" Version="2.0.0-rc5.4" />
	  <PackageReference Include="LiveChartsCore.SkiaSharpView" Version="2.0.0-rc5.4" />
	  <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.0-rc5.4" />
	  <PackageReference Include="MaterialDesignColors" Version="5.2.1" />
	  <PackageReference Include="MaterialDesignThemes" Version="5.2.1" />
	  <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.20" />
	  <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="6.0.36" />
	  <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.3">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
	  <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="6.0.2" />
	  <PackageReference Include="Microsoft.Office.Interop.Excel" Version="15.0.4795.1001" />
	  <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
	  <PackageReference Include="NLog" Version="6.0.2" />
	  <PackageReference Include="NLog.Config" Version="4.7.15" />
	  <PackageReference Include="QRCoder" Version="1.6.0" />
	  <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.2" />
	  <PackageReference Include="System.Data.OleDb" Version="6.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Interop.bpac">
      <HintPath>DLL\Interop.bpacx64.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Image\database.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\Image\material.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\Image\plc.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\Image\printer.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\Image\schedule.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\Image\worker.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\ImportTemplate\master.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\ImportTemplate\mastercsv.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\ImportTemplate\masterError.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\ImportTemplate\masterErrorcsv.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\ImportTemplate\Person.xlsx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\ImportTemplate\Personcsv.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\TemplatePrint\Temp.lbx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\TemplatePrint\temp2.lbx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
