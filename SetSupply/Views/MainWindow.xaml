<Window x:Class="APP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:APP"
        xmlns:uc ="clr-namespace:APP.UserControls"
        xmlns:componenUI="clr-namespace:APP.ComponentUI"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors">


    <materialDesign:DrawerHost x:Name="DrawerHost" BorderBrush="{DynamicResource MaterialDesignDivider}" OpenMode="Standard">
        <materialDesign:DrawerHost.LeftDrawerContent>

            <Border >
                <Border.Effect>
                    <DropShadowEffect Color="Gray" Direction="315" ShadowDepth="4" 
                          BlurRadius="20" Opacity="0.8"/>
                </Border.Effect>
                <Grid Background="#F5F5F5">
                    <Grid.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                            <Setter Property="Height" Value="120"></Setter>
                            <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                            <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
                        </Style>
                        <Style TargetType="Label">
                            <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                            <Setter Property="FontSize" Value="20"></Setter>
                            <Setter Property="FontWeight" Value="Bold"></Setter>
                        </Style>
                        <Style TargetType="materialDesign:PackIcon">
                            <Setter Property="Height" Value="80"></Setter>
                            <Setter Property="Width" Value="80"></Setter>
                            <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                            <Setter Property="Foreground" Value="DarkSlateBlue"></Setter>
                        </Style>
                    </Grid.Resources>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Menu -->
                        <RowDefinition Height="*"/>
                        <!-- Khoảng trống -->
                        <RowDefinition Height="Auto"/>
                        <!-- Version -->
                    </Grid.RowDefinitions>

                    <!-- Menu -->

                    <StackPanel Grid.Row="0" >

                        <Button Command="{Binding ShowHomeCommand}">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="Home" Foreground="SteelBlue" />
                                <Label Content="{DynamicResource Home}" />
                            </StackPanel>
                        </Button>
                        <Separator></Separator>
                        <Button Command="{Binding ShowDashBoardCommand}">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="MonitorDashboard" Foreground="ForestGreen" />
                                <Label Content="{DynamicResource DashBoard}" />
                            </StackPanel>
                        </Button>
                        <Separator></Separator>
                        <Button Command="{Binding ShowSettingCommand}">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="CogOutline" Foreground="#212121" />
                                <Label Content="{DynamicResource Setting}" />
                            </StackPanel>
                        </Button>
                        <Separator></Separator>
                        <Button Command="{Binding ShowHistoryCommand}">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="History" Foreground="OrangeRed" />
                                <Label Content="{DynamicResource History}" />
                            </StackPanel>
                        </Button>
                        <Separator></Separator>
                        <!--<Button Command="{Binding ShowHelpCommand}">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="Help" Foreground="YellowGreen" />
                                <Label Content="Help" />
                            </StackPanel>
                        </Button>
                        <Separator></Separator>-->
                    </StackPanel>

                    <!-- Version ở dưới -->
                    <Label Grid.Row="2" Content="Version:2025" FontStyle="Italic"  HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" FontSize="16" FontWeight="Medium" Foreground="Black"/>
                </Grid>

            </Border>
        </materialDesign:DrawerHost.LeftDrawerContent>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== THANH TIÊU ĐỀ ===== -->
            <Border Grid.Row="0" Padding="6,8,8,8" TextElement.FontFamily="Bahnschrift SemiCondensed, Segoe UI">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#0B3470" Offset="0"/>
                        <GradientStop Color="#0F4590" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ToggleButton Grid.Column="0" IsChecked="{Binding ElementName=DrawerHost, Path=IsLeftDrawerOpen, Mode=TwoWay}"
                                  Foreground="White" Background="Transparent" BorderBrush="Transparent"
                                  Style="{StaticResource MaterialDesignHamburgerToggleButton}" VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1" Text="Panasonic" FontFamily="Arial" FontWeight="Bold" FontSize="36"
                               Foreground="White" VerticalAlignment="Center" Margin="10,0,0,2"/>

                    <Rectangle Grid.Column="2" Width="2" Height="40" Fill="#6F93CC" Margin="20,0" VerticalAlignment="Center"/>

                    <DockPanel Grid.Column="3" VerticalAlignment="Center" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left" Text="{Binding ApplicationTitle}" FontSize="32" FontWeight="Bold"
                                   Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding PageSubtitle}" FontSize="19" Foreground="#D5E2F6" Margin="16,4,12,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <!-- Điều khiển riêng của trang (Home: ngày / ca / cài đặt) -->
                    <ContentControl Grid.Column="4" Content="{Binding HeaderToolbar}" VerticalAlignment="Center"/>

                    <materialDesign:Chip Grid.Column="5" FontWeight="Bold" Content="{Binding CurrentUser}" Icon="{Binding Avatar}"
                                         Background="White" VerticalAlignment="Center" Margin="16,0,4,0">
                        <materialDesign:Chip.ContextMenu>
                            <ContextMenu materialDesign:MenuAssist.MenuItemsPresenterMargin="0" Placement="Bottom" StaysOpen="True">
                                <MenuItem Visibility="{Binding IsLoginVisibility}" Header="Login" Icon="{materialDesign:PackIcon Kind=Login}" Command="{Binding LoginCommand}" />
                                <MenuItem Visibility="{Binding IsLogoutVisibility}" Header="Logout" Icon="{materialDesign:PackIcon Kind=Logout}" Command="{Binding LogoutCommand}"/>
                                <MenuItem Visibility="{Binding IsAdmin}" Header="User Management" Icon="{materialDesign:PackIcon Kind=AccountGroup}" Command="{Binding UserManagementMethodCommand}"/>
                                <MenuItem Header="Change language" Icon="{materialDesign:PackIcon Kind=Language}" Command="{Binding ChangeLanguageCommand}"/>
                            </ContextMenu>
                        </materialDesign:Chip.ContextMenu>
                    </materialDesign:Chip>

                    <uc:UCControlBar Grid.Column="6" Background="Transparent" Tag="0" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Background="#EEF3F9">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>

                <!-- Tiêu đề trang (ẩn ở Home vì Home đã có header riêng) -->
                <Grid Margin="10,6,20,5" Grid.Row="0" Visibility="{Binding PageHeaderVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"></ColumnDefinition>
                        <ColumnDefinition Width="*"></ColumnDefinition>
                        <ColumnDefinition Width="auto"></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <materialDesign:PackIcon VerticalAlignment="Center" Width="35" Height="35" Kind="{Binding PageIcon}" Foreground="DarkSlateBlue" />
                        <TextBlock Grid.Column="0" Text="{Binding Selectedpage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="30" FontWeight="Bold" Foreground="DarkSlateBlue" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Center">
                        </TextBlock>
                    </StackPanel>

                    <componenUI:RealtimeClock Grid.Column="1" HorizontalAlignment="Center" ></componenUI:RealtimeClock>

                    <TextBlock VerticalAlignment="Center" Grid.Column="2" Text="{Binding StatusConnectionPLC}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="Black"/>

                                <Setter Property="FontSize" Value="20"/>

                                <Setter Property="FontWeight" Value="Bold"/>

                                <Style.Triggers>

                                    <!-- Connected -> Green -->
                                    <DataTrigger Binding="{Binding StatusConnectionPLC}" Value="Connected">
                                        <Setter Property="Foreground" Value="Green"/>
                                    </DataTrigger>

                                    <!-- Disconnect -> Red -->
                                    <DataTrigger Binding="{Binding StatusConnectionPLC}" Value="Disconnected">
                                        <Setter Property="Foreground" Value="Red"/>
                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <ContentControl Grid.Row="1" Content="{Binding CurrentView}" />
            </Grid>
        </Grid>
    </materialDesign:DrawerHost>

</Window>

